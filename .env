# Read by `docker compose` from this directory. Every name here is optional
# except the first, and every one of them has a default in docker-compose.yml.

# Which shape comes up. `mono` is the whole pipeline in one process; `split`
# is the ASR and the synthesiser as their own workers behind a gateway. They
# are alternatives - both publish the same port - so this picks one.
# `docker compose --profile split up` overrides it for a single run.
COMPOSE_PROFILES=mono

# Where the checkpoints are. Mounted read-only at /models, and the tree inside
# has the same shape as `models/` here, so the paths in docker-compose.yml are
# the ones docs/CLI.md already uses.
#XABE_MODELS=./models

# Published port for the monolith and for the split's gateway.
#XABE_PORT=8000

# Which card each stage takes. All default to 0 - the whole pipeline on one -
# except the split's synthesiser and translator, which default to 1 because
# spreading the cards is the only reason to run split at all.
#XABE_ASR_DEVICE=0
#XABE_TTS_DEVICE=0
#XABE_LLM_DEVICE=0
#XABE_TRANSLATOR_DEVICE=0

# The two GGUFs, by filename within /models.
#XABE_LLM_GGUF=breeze2-8b-Q4_K_M.gguf
#XABE_TRANSLATOR_GGUF=taigi-translator-13b-Q4_K_M.gguf

# How long a container may take to load before a failing healthcheck counts.
#XABE_START_PERIOD=600s

# Where the system prompts are. Mounted read-only at /prompts; the directory
# is gitignored, so it is yours to fill and may be empty.
#XABE_PROMPTS=./prompts

# The chat model's system prompt, replacing the built-in one. Either a path
# under the mount, or `XABE_SYSTEM_PROMPT` with the text inline - the two are
# alternatives and giving both is refused. Left unset, the engine uses its
# built-in and needs no file at all, which is why these ship commented: a
# committed default pointing into a gitignored directory would leave a fresh
# clone unable to start.
#
# **Uncomment the pair, not one of them.** A prompt file is taken literally,
# with no {person}/{bot} substitution, so the name written in it has to be the
# name `XABE_BOT` gives the transcript - the stop strings are derived from
# that, and a mismatch lets the model write the user's next turn itself.
#XABE_PROMPT_FILE=/prompts/your-prompt.txt
#XABE_BOT=小助理
#XABE_SYSTEM_PROMPT=

#RUST_LOG=info
